<!-- Gray.xaml — серая тема: приглушённая, заметно темнее светлой -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFD6D6D6"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFC2C2C2"/>
    <SolidColorBrush x:Key="GroupBoxBackgroundBrush" Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="ToolBarBrush" Color="#FFC2C2C2"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#FFBABABA"/>
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#FFB8B8B8"/>
    <SolidColorBrush x:Key="TextBoxBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="ListBoxBrush" Color="#FFDCDCDC"/>
    <SolidColorBrush x:Key="TabHeaderBrush" Color="#FFB4B4B4"/>
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#FFD6D6D6"/>
    <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#FFC4C4C4"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#FFA8A8A8"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#FFCDCDCD"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#FFBFD2E6"/>
    <SolidColorBrush x:Key="RowPassBrush" Color="#FFC9DCB9"/>
    <SolidColorBrush x:Key="RowFailBrush" Color="#FFE6C4C4"/>
    <SolidColorBrush x:Key="RowWarnBrush" Color="#FFE7DBA8"/>
</ResourceDictionary>
