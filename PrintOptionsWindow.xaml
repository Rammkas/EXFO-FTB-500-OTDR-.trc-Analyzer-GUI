<Window x:Class="ExfoTrcAnalyzerGUI.PrintOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.po_title}" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="14">
        <CheckBox x:Name="ChkMap" Content="{DynamicResource L.po_map}" Margin="0,3" IsChecked="True"/>
        <CheckBox x:Name="ChkFibers" Content="{DynamicResource L.po_fibers}" Margin="0,3" IsChecked="True"/>
        <CheckBox x:Name="ChkSections" Content="{DynamicResource L.po_sections}" Margin="0,3" IsChecked="True"/>
        <CheckBox x:Name="ChkEvents" Content="{DynamicResource L.po_events}" Margin="0,3" IsChecked="True"/>
        <TextBlock Text="{DynamicResource L.po_note}"
                   Opacity="0.75" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="{DynamicResource L.btn_print}" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="{DynamicResource L.btn_cancel}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
