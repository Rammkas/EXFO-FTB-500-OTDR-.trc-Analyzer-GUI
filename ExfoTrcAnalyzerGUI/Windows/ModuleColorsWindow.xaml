<Window x:Class="ExfoTrcAnalyzerGUI.Windows.ModuleColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.set_colors_group}" Width="470" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <StackPanel Margin="14">
        <TextBlock Text="{DynamicResource L.set_colors_note}"
                   Opacity="0.75" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <UniformGrid x:Name="ColorOrderPanel" Columns="2"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource L.btn_save}" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="{DynamicResource L.btn_reset}" Click="BtnReset_Click"/>
            <Button Content="{DynamicResource L.btn_cancel}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
