<Window x:Class="ExfoTrcAnalyzerGUI.Windows.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.help_title}" Width="760" Height="640"
        MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="18" FontWeight="Bold" Margin="0,0,0,8" Text="{DynamicResource L.help_head}"/>

            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,10,0,4" Text="{DynamicResource L.help_verdicts_head}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1">
                <Run Text="● " Foreground="ForestGreen" FontSize="14"/><Run Text="{DynamicResource L.help_green}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,1">
                <Run Text="● " Foreground="#D4A017" FontSize="14"/><Run Text="{DynamicResource L.help_yellow}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,1">
                <Run Text="● " Foreground="Firebrick" FontSize="14"/><Run Text="{DynamicResource L.help_red}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,1">
                <Run Text="● " Foreground="Gray" FontSize="14"/><Run Text="{DynamicResource L.help_gray}"/>
            </TextBlock>

            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" Text="{DynamicResource L.help_att_head}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_att1}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_att2}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_att3}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_att4}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_att5}"/>

            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" Text="{DynamicResource L.help_nav_head}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_nav1}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_nav2}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_nav3}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_nav4}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_nav5}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_nav6}"/>

            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" Text="{DynamicResource L.help_map_head}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_map1}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_map2}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_map3}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_map4}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_map5}"/>

            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" Text="{DynamicResource L.help_mod_head}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_mod1}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_mod2}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_mod3}"/>

            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" Text="{DynamicResource L.help_set_head}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_set1}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" FontWeight="SemiBold" Text="{DynamicResource L.help_set2}"/>

            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" Text="{DynamicResource L.help_print_head}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,1" Text="{DynamicResource L.help_print1}"/>

            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" Text="{DynamicResource L.help_csv_head}"/>
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource L.help_csv1}"/>

            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" Text="{DynamicResource L.help_theme_head}"/>
            <TextBlock TextWrapping="Wrap" Text="{DynamicResource L.help_theme1}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
